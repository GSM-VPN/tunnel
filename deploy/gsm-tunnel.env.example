# 이 파일을 /etc/gsm-tunnel/gsm-tunnel.env로 복사하고 권한을 0600으로 설정한다.
# 실제 secret과 private key는 커밋하지 않는다.

# Go Controller와 기존 vpn-server 서비스 계층 설정.
GATEWAY_SHARED_SECRET=replace-with-gateway-service-secret
VPN_SERVER_ID=replace-with-stable-server-id
TUNNEL_CORE_BINARY=/usr/local/libexec/gsm-tunnel-core
TUNNEL_CORE_IPC_SOCKET=/run/gsm-tunnel/core.sock
TUNNEL_CORE_MAX_PEERS=216

# Rust Tunnel Core 신원 키. 정확히 32바이트를 표준 Base64로 인코딩해야 한다.
# 생성 예시:
#   openssl rand -base64 32
SERVER_PRIVATE_KEY=replace-with-32-byte-base64-private-key
